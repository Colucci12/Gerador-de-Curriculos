# Variáveis do stack (Portainer Environment) — não use env_file no compose.
# O Compose interpola ${...}; as do app entram via environment: no docker-compose.yml.

# Flask
SECRET_KEY=

# Fernet (chaves Gemini dos usuários)
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Traefik / Portainer (só interpolação do compose)
APP_DOMAIN=
TRAEFIK_NETWORK=traefik
TRAEFIK_ENTRYPOINT=websecure

# Opcional: só CLI
GOOGLE_API_KEY=
